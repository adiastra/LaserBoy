# project LaserBoy
# James Lehman
# laserboy.org

RM       = rm -f
STRIP    = strip -s -v
CPP      = g++
INC      = -I/usr/local/src/boost_1_74_0
LIB      = -L/usr/local/src/boost_1_74_0/stage/lib
LIBS     = -lSDL -lboost_filesystem -lboost_system -lpthread

CPPFLAGS = -std=c++17 \
           -O3 \
           -Wall \
           -Wextra \
           -frounding-math \
           -fsignaling-nans \
           -Wno-psabi \
           -Wno-unused-parameter \
           -Wno-implicit-fallthrough \
           -Wno-missing-field-initializers \
           -Wno-misleading-indentation \
           -Wno-unused-but-set-variable \
           -Wno-mismatched-new-delete \
           -fexpensive-optimizations \
           -static \
           $(INC) \
           $(LIB) \
           $(LIBS)

HEADERS   = LaserBoy_includes.hpp \
            LaserBoy_macros.hpp \
            LaserBoy_common.hpp \
            LaserBoy_oscillator.hpp \
            LaserBoy_utility.hpp \
            LaserBoy_font.hpp \
            LaserBoy_bmp.hpp \
            LaserBoy_3D_short.hpp \
            LaserBoy_color.hpp \
            LaserBoy_vertex.hpp \
            LaserBoy_segment.hpp \
            LaserBoy_3D_double.hpp \
            LaserBoy_real_vertex.hpp \
            LaserBoy_real_segment.hpp \
            LaserBoy_real_segment_set.hpp \
            LaserBoy_ild_header.hpp \
            LaserBoy_frame.hpp \
            LaserBoy_frame_set.hpp \
            LaserBoy_palette.hpp \
            LaserBoy_palette_set.hpp \
            LaserBoy_wave.hpp \
            LaserBoy_SDL_GUI.hpp \
            LaserBoy_space.hpp \
            LaserBoy_TUI.hpp

OBJ      = ../build/LaserBoy.opi \
           ../build/LaserBoy_common.opi \
           ../build/LaserBoy_oscillator.opi \
           ../build/LaserBoy_frame.opi \
           ../build/LaserBoy_frame_effects.opi \
           ../build/LaserBoy_selected_frames_effects.opi \
           ../build/LaserBoy_frame_set.opi \
           ../build/LaserBoy_frame_set_effects.opi \
           ../build/LaserBoy_ild_header.opi \
           ../build/LaserBoy_segment.opi \
           ../build/LaserBoy_palette.opi \
           ../build/LaserBoy_palette_set.opi \
           ../build/LaserBoy_real_segment.opi \
           ../build/LaserBoy_real_segment_set.opi \
           ../build/LaserBoy_wave.opi \
           ../build/LaserBoy_space.opi \
           ../build/LaserBoy_TUI.opi \
           ../build/LaserBoy_SDL_GUI.opi \
           ../build/LaserBoy_bmp.opi \
           ../build/LaserBoy_font.opi

BIN      = ../LaserBoy_sdl1_rpi

all: $(BIN) strip

strip:
	$(STRIP) $(BIN)

clean:
	$(RM) $(OBJ) $(BIN)

$(BIN): $(OBJ)
	$(CPP) $(OBJ) -o $(BIN) $(LIB) $(LIBS)

../build/LaserBoy.opi: LaserBoy.cpp $(HEADERS)
	$(CPP) -c LaserBoy.cpp -o ../build/LaserBoy.opi $(CPPFLAGS)

../build/LaserBoy_SDL_GUI.opi: LaserBoy_SDL_GUI.cpp $(HEADERS)
	$(CPP) -c LaserBoy_SDL_GUI.cpp -o ../build/LaserBoy_SDL_GUI.opi $(CPPFLAGS)

../build/LaserBoy_TUI.opi: LaserBoy_TUI.cpp $(HEADERS)
	$(CPP) -c LaserBoy_TUI.cpp -o ../build/LaserBoy_TUI.opi $(CPPFLAGS)

../build/LaserBoy_space.opi: LaserBoy_space.cpp $(HEADERS)
	$(CPP) -c LaserBoy_space.cpp -o ../build/LaserBoy_space.opi $(CPPFLAGS)

../build/LaserBoy_frame_set_effects.opi: LaserBoy_frame_set_effects.cpp $(HEADERS)
	$(CPP) -c LaserBoy_frame_set_effects.cpp -o ../build/LaserBoy_frame_set_effects.opi $(CPPFLAGS)

../build/LaserBoy_selected_frames_effects.opi: LaserBoy_selected_frames_effects.cpp $(HEADERS)
	$(CPP) -c LaserBoy_selected_frames_effects.cpp -o ../build/LaserBoy_selected_frames_effects.opi $(CPPFLAGS)

../build/LaserBoy_frame_effects.opi: LaserBoy_frame_effects.cpp $(HEADERS)
	$(CPP) -c LaserBoy_frame_effects.cpp -o ../build/LaserBoy_frame_effects.opi $(CPPFLAGS)

../build/LaserBoy_palette_set.opi: LaserBoy_palette_set.cpp $(HEADERS)
	$(CPP) -c LaserBoy_palette_set.cpp -o ../build/LaserBoy_palette_set.opi $(CPPFLAGS)

../build/LaserBoy_palette.opi: LaserBoy_palette.cpp $(HEADERS)
	$(CPP) -c LaserBoy_palette.cpp -o ../build/LaserBoy_palette.opi $(CPPFLAGS)

../build/LaserBoy_frame_set.opi: LaserBoy_frame_set.cpp $(HEADERS)
	$(CPP) -c LaserBoy_frame_set.cpp -o ../build/LaserBoy_frame_set.opi $(CPPFLAGS)

../build/LaserBoy_frame.opi: LaserBoy_frame.cpp $(HEADERS)
	$(CPP) -c LaserBoy_frame.cpp -o ../build/LaserBoy_frame.opi $(CPPFLAGS)

../build/LaserBoy_ild_header.opi: LaserBoy_ild_header.cpp LaserBoy_ild_header.hpp LaserBoy_common.hpp LaserBoy_macros.hpp LaserBoy_includes.hpp
	$(CPP) -c LaserBoy_ild_header.cpp -o ../build/LaserBoy_ild_header.opi $(CPPFLAGS)

../build/LaserBoy_bmp.opi: LaserBoy_bmp.cpp LaserBoy_bmp.hpp LaserBoy_font.hpp LaserBoy_color.hpp LaserBoy_common.hpp LaserBoy_macros.hpp LaserBoy_includes.hpp
	$(CPP) -c LaserBoy_bmp.cpp -o ../build/LaserBoy_bmp.opi $(CPPFLAGS)

../build/LaserBoy_font.opi: LaserBoy_font.cpp LaserBoy_font.hpp
	$(CPP) -c LaserBoy_font.cpp -o ../build/LaserBoy_font.opi $(CPPFLAGS)

../build/LaserBoy_segment.opi: LaserBoy_segment.cpp $(HEADERS)
	$(CPP) -c LaserBoy_segment.cpp -o ../build/LaserBoy_segment.opi $(CPPFLAGS)

../build/LaserBoy_real_segment.opi: LaserBoy_real_segment.cpp $(HEADERS)
	$(CPP) -c LaserBoy_real_segment.cpp -o ../build/LaserBoy_real_segment.opi $(CPPFLAGS)

../build/LaserBoy_real_segment_set.opi: LaserBoy_real_segment_set.cpp $(HEADERS)
	$(CPP) -c LaserBoy_real_segment_set.cpp -o ../build/LaserBoy_real_segment_set.opi $(CPPFLAGS)

../build/LaserBoy_wave.opi: LaserBoy_wave.cpp LaserBoy_wave.hpp LaserBoy_common.hpp LaserBoy_macros.hpp LaserBoy_includes.hpp
	$(CPP) -c LaserBoy_wave.cpp -o ../build/LaserBoy_wave.opi $(CPPFLAGS)

../build/LaserBoy_oscillator.opi: LaserBoy_oscillator.cpp LaserBoy_oscillator.hpp LaserBoy_common.hpp LaserBoy_includes.hpp
	$(CPP) -c LaserBoy_oscillator.cpp -o ../build/LaserBoy_oscillator.opi $(CPPFLAGS)

../build/LaserBoy_common.opi: LaserBoy_common.cpp LaserBoy_common.hpp LaserBoy_macros.hpp LaserBoy_includes.hpp
	$(CPP) -c LaserBoy_common.cpp -o ../build/LaserBoy_common.opi $(CPPFLAGS)
